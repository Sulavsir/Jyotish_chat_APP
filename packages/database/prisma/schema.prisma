// Admin Chat - Direct chat between users and admins (support widget)
model AdminChat {
  id            String        @id @default(uuid())
  userId        String?       // Client user who initiated the chat (null if astrologer initiated)
  astrologerId  String?       // Astrologer who initiated the chat (null if client initiated)
  adminId       String?       // Admin who responds (null if no admin assigned yet)
  status        AdminChatStatus @default(ACTIVE)
  lastMessageAt DateTime?
  lastMessageText String?
  userRead      Boolean       @default(true)
  adminRead     Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User?         @relation("UserAdminChats", fields: [userId], references: [id], onDelete: Cascade)
  astrologer    Astrologer?   @relation("AstrologerAdminChats", fields: [astrologerId], references: [id], onDelete: Cascade)
  admin         Admin?        @relation("AdminAdminChats", fields: [adminId], references: [id], onDelete: SetNull)
  messages      AdminChatMessage[]

  @@index([userId])
  @@index([astrologerId])
  @@index([adminId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([createdAt])
}

// Admin Chat Messages
model AdminChatMessage {
  id        String        @id @default(uuid())
  chatId    String
  senderId  String        // User ID or Admin ID
  senderType AdminChatSenderType // USER or ADMIN
  content   String
  type      MessageType   @default(TEXT)
  metadata  Json?
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  chat      AdminChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
  @@index([senderType])
  @@index([createdAt])
}

enum AdminChatStatus {
  ACTIVE
  RESOLVED
  CLOSED
}

enum AdminChatSenderType {
  USER
  ADMIN
}

model CoinTransaction {
  id            String                @id @default(uuid())
  userId        String
  amount        Int // Positive for add, negative for deduct
  type          CoinTransactionType
  reason        CoinTransactionReason
  balanceBefore Int // Balance before transaction
  balanceAfter  Int // Balance after transaction
  chatId        String? // If transaction is related to a chat
  paymentId    String? // If transaction is from a payment
  adminId      String? // If transaction was added by admin
  metadata      Json? // Additional transaction details
  createdAt     DateTime              @default(now())
  user          User                  @relation("CoinTransactions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([reason])
  @@index([createdAt])
  @@index([chatId])
  @@index([paymentId])
}

enum CoinTransactionType {
  DEDUCT
  ADD
  REFUND
}

enum CoinTransactionReason {
  CHAT_ORDINARY
  CHAT_PREMIUM
  PURCHASE
  REFUND
  ADMIN_ADJUSTMENT
  PAYMENT_SUCCESS
}
