  clientId     String // User who gave the rating
  astrologerId String // Astrologer who received the rating
  rating       Int // Rating value (1-5 stars)
  feedback     String? // Optional text feedback
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  chat         Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  client       User       @relation("ClientRatings", fields: [clientId], references: [id], onDelete: Cascade)
  astrologer   Astrologer @relation("AstrologerRatings", fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([astrologerId])
  @@index([rating])
}

