generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// Client users only
model User {
  id                           String                 @id @default(uuid())
  phone                        String                 @unique
  email                        String?                @unique
  password                     String?
  name                         String?
  role                         UserRole               @default(CLIENT)
  isActive                     Boolean                @default(true)
  isOnline                     Boolean                @default(false)
  emailVerified                DateTime?
  profilePhoto                 String?
  profileCompleted             Boolean                @default(false)
  dateOfBirth                  DateTime?
  timeOfBirth                  String?
  placeOfBirth                 String?
  currentAddress               String?
  permanentAddress             String?
  latitude                     Float?
  longitude                    Float?
  zodiacSign                   ZodiacSign?
  gender                       Gender?
  coins                        Int                    @default(0)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  userPlans                    UserPlan[]
  consultationsAsClient        Consultation[]         @relation("ClientConsultations")
  instantChatRequestsAsClient  InstantChatRequest[]   @relation("ClientInstantChatRequests")
  consultationRequestsAsClient ConsultationRequest[]  @relation("ClientConsultationRequests")
  broadcastMessagesAsClient    BroadcastMessage[]     @relation("ClientBroadcastMessages")
  horoscopeSubscriptions       HoroscopeSubscription?
  notifications                Notification[]
  notificationSettings         NotificationSettings?
  payments                     Payment[]
  sessions                     Session[]
  chatsAsClient                Chat[]                 @relation("ChatParticipant1")
  adminChatsAsUser              AdminChat[]           @relation("UserAdminChats")
  auditLogs                    AuditLog[]
  appointments                 Appointment[]          @relation("ClientAppointments")
  complaintsAsClient           Complaint[]            @relation("ClientComplaints")
  ratingsGiven                 Rating[]               @relation("ClientRatings")
  coinTransactions             CoinTransaction[]      @relation("CoinTransactions")
  jyotishBookingRequests       JyotishBookingRequest[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([isOnline])
  @@index([zodiacSign])
}

// Astrologer (Jyotish) - Created and managed by admin only
model Astrologer {
  id                           String                @id @default(uuid())
  phone                        String                @unique
  email                        String?               @unique
  password                     String // Required for login
  name                         String
  profilePhoto                 String?
  bio                          String?
  specialization               String[] // e.g., ["Vedic", "Tarot", "Numerology"]
  experience                   Int? // Years of experience
  rating                       Float?                @default(0.0)
  totalConsultations           Int                   @default(0)
  category                     AstrologerCategory    @default(ORDINARY) // Astrologer tier
  appointmentFee               Float? // Fee for appointments (applicable for PROFESSIONAL and PREMIUM)
  isActive                     Boolean               @default(true)
  isOnline                     Boolean               @default(false)
  isVerified                   Boolean               @default(false)
  accountStatus                AstrologerAccountStatus @default(PENDING) // Registration approval status
  proofOfAstrology              String? // URL to certificate/proof document
  registrationRequestedAt       DateTime? // When registration was requested
  approvedBy                    String? // Admin ID who approved/rejected
  approvedAt                    DateTime? // When approval/rejection happened
  rejectionReason               String? // Reason if rejected
  commissionRate               Float                 @default(0.0) // Percentage (e.g., 20.0 for 20%)
  bankAccountDetails           Json? // Store bank info securely
  documentVerification         Json? // Store verification documents metadata
  availabilitySchedule         Json? // Store weekly schedule
  languages                    String[]              @default(["English", "Nepali"])
  gender                       Gender?
  createdBy                    String // Admin ID who created this astrologer (or "SELF_REGISTERED" for self-registrations)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  consultationsAsAstrologer    Consultation[]        @relation("AstrologerConsultations")
  acceptedInstantChatRequests  InstantChatRequest[]  @relation("AcceptedInstantChatRequests")
  acceptedConsultationRequests ConsultationRequest[] @relation("AcceptedConsultationRequests")
  acceptedBroadcastMessages    BroadcastMessage[]    @relation("AcceptedBroadcastMessages")
  astrologerNotifications      Notification[]        @relation("AstrologerNotifications")
  astrologerSessions           Session[]             @relation("AstrologerSessions")
  chatsAsAstrologer            Chat[]                @relation("ChatAstrologerParticipant2")
  auditLogs                    AuditLog[]            @relation("AstrologerAuditLogs")
  earnings                     AstrologerEarnings[]
  appointments                 Appointment[]                @relation("AstrologerAppointments")
  complaintsReceived           Complaint[]                  @relation("AstrologerComplaints")
  dismissedBroadcastMessages   BroadcastMessageDismissal[]  @relation("DismissedBroadcastMessages")
  ratingsReceived              Rating[]                     @relation("AstrologerRatings")
  adminChatsAsAstrologer       AdminChat[]                  @relation("AstrologerAdminChats")
  preferredJyotishBookingRequests JyotishBookingRequest[]   @relation("PreferredAstrologerBookings")

  @@index([phone])
  @@index([email])
  @@index([isActive])
  @@index([isOnline])
  @@index([rating])
  @@index([category])
  @@index([accountStatus])
}

// Admin users for managing the platform
model Admin {
  id                 String      @id @default(uuid())
  email              String      @unique
  password           String
  name               String
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  auditLogs          AuditLog[]
  resolvedComplaints Complaint[] @relation("ResolvedComplaints")
  adminChats         AdminChat[] @relation("AdminAdminChats")

  @@index([email])
  @@index([isActive])
}

// Audit logging for admin monitoring
model AuditLog {
  id           String      @id @default(uuid())
  userId       String? // Client user ID (if applicable)
  astrologerId String? // Astrologer ID (if applicable)
  adminId      String? // Admin who performed the action (if applicable)
  action       AuditAction // Type of action performed
  resource     String // Resource affected (e.g., "User", "Chat", "Consultation")
  resourceId   String? // ID of the affected resource
  details      Json? // Additional details about the action
  ipAddress    String?
  userAgent    String?
  metadata     Json? // Extra context (e.g., before/after values)
  createdAt    DateTime    @default(now())
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  astrologer   Astrologer? @relation("AstrologerAuditLogs", fields: [astrologerId], references: [id], onDelete: SetNull)
  admin        Admin?      @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([astrologerId])
  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([userId, action])
  @@index([astrologerId, action])
}

// Astrologer earnings and commission tracking
model AstrologerEarnings {
  id             String        @id @default(uuid())
  astrologerId   String
  consultationId String?
  chatId         String?
  amount         Float // Total amount earned
  commission     Float // Platform commission
  netEarning     Float // Amount after commission
  status         EarningStatus @default(PENDING)
  payoutDate     DateTime? // When the earning was paid out
  transactionId  String? // Payment transaction reference
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  astrologer     Astrologer    @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([astrologerId])
  @@index([status])
  @@index([createdAt])
  @@index([astrologerId, status])
}

model Session {
  id               String          @id @default(uuid())
  userId           String? // For client users
  astrologerId     String? // For astrologers
  userType         SessionUserType // CLIENT, ASTROLOGER, ADMIN
  refreshTokenHash String          @unique // Hashed refresh token for security
  accessToken      String? // Optional: for tracking (not used for validation)
  expiresAt        DateTime // Refresh token expiration
  isRevoked        Boolean         @default(false) // For logout/revocation
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime        @default(now()) // Track last refresh
  createdAt        DateTime        @default(now())
  
  // Device tracking for session management
  deviceId         String? // Unique device identifier from client
  deviceType       DeviceType? // MOBILE or DESKTOP
  deviceName       String? // e.g., "iPhone 15", "Chrome on Windows"
  
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologer       Astrologer?     @relation("AstrologerSessions", fields: [astrologerId], references: [id], onDelete: Cascade)

  // Legacy field for backward compatibility
  token String? @unique

  @@index([userId])
  @@index([astrologerId])
  @@index([refreshTokenHash])
  @@index([userId, isRevoked])
  @@index([astrologerId, isRevoked])
  @@index([expiresAt])
  @@index([userId, deviceType, isRevoked])
  @@index([astrologerId, deviceType, isRevoked])
}

model OTPSession {
  id          String   @id @default(uuid())
  phoneNumber String
  otp         String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([phoneNumber, verified])
  @@index([expiresAt])
}

model Chat {
  id                    String          @id @default(uuid())
  participant1Id        String // Client User ID
  participant2Id        String // Astrologer ID
  participant1Type      ParticipantType @default(CLIENT) // Always CLIENT for participant1
  participant2Type      ParticipantType @default(ASTROLOGER) // Always ASTROLOGER for participant2
  consultationId        String?
  status                ChatStatus      @default(ACTIVE)
  isLocked              Boolean         @default(false) // When true, chat is locked (like Facebook block)
  endedBy               String? // User/Astrologer ID who ended the chat
  endedAt               DateTime? // When the chat was ended
  lastMessageAt         DateTime?
  lastMessageText       String?
  participant1Read      Boolean         @default(true)
  participant2Read      Boolean         @default(true)
  isMonitoredByAdmin    Boolean         @default(false) // Flag for admin monitoring
  adminNotes            String? // Admin notes about this chat
  isAbandonedByAdmin    Boolean         @default(false) // When true, chat is abandoned by admin (both parties blocked)
  abandonedBy           String? // Admin ID who abandoned the chat
  abandonedAt           DateTime? // When the chat was abandoned
  abandonReason         String? // Admin's reason for abandoning
  // Turn-based messaging fields
  waitingForReply       Boolean         @default(false) // True when client sent message and waiting for astrologer reply
  lastClientMessageAt   DateTime? // When client last sent a message
  lastAstrologerReplyAt DateTime? // When astrologer last replied
  turnBasedEnabled      Boolean         @default(true) // Enable/disable turn-based messaging for this chat
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  clientParticipant     User            @relation("ChatParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  astrologerParticipant Astrologer      @relation("ChatAstrologerParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages              Message[]
  rating                Rating?
  complaints            Complaint[]

  @@unique([participant1Id, participant2Id]) // Keep unique - same chat is reused
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([consultationId])
  @@index([lastMessageAt])
  @@index([status])
  @@index([isLocked])
  @@index([isMonitoredByAdmin])
  @@index([isAbandonedByAdmin])
  @@index([waitingForReply])
}

model Message {
  id             String          @id @default(uuid())
  chatId         String
  senderId       String // ID of sender (User or Astrologer)
  receiverId     String // ID of receiver (User or Astrologer)
  senderType     ParticipantType // CLIENT or ASTROLOGER
  receiverType   ParticipantType // CLIENT or ASTROLOGER
  content        String
  type           MessageType     @default(TEXT)
  metadata       Json?
  isRead         Boolean         @default(false)
  isDeleted      Boolean         @default(false)
  flaggedByAdmin Boolean         @default(false) // Admin can flag inappropriate messages
  adminNotes     String? // Admin notes about this message
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  chat           Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
  @@index([receiverId])
  @@index([senderType])
  @@index([receiverType])
  @@index([createdAt])
  @@index([flaggedByAdmin])
}

model Consultation {
  id           String             @id @default(uuid())
  clientId     String
  astrologerId String
  scheduledAt  DateTime
  duration     Int
  status       ConsultationStatus @default(PENDING)
  type         ConsultationType
  amount       Float
  notes        String?
  rating       Int?
  review       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  astrologer   Astrologer         @relation("AstrologerConsultations", fields: [astrologerId], references: [id], onDelete: Cascade)
  client       User               @relation("ClientConsultations", fields: [clientId], references: [id], onDelete: Cascade)
  payment      Payment?

  @@index([clientId])
  @@index([astrologerId])
  @@index([scheduledAt])
  @@index([status])
}

// Instant Chat Request - Like ride-sharing app, broadcast to all online astrologers
model InstantChatRequest {
  id                 String                   @id @default(uuid())
  clientId           String
  clientName         String?
  clientPhoto        String?
  message            String? // Optional message from client
  status             InstantChatRequestStatus @default(PENDING)
  acceptedBy         String? // Astrologer ID who accepted
  chatId             String? // Link to created chat
  expiresAt          DateTime // Auto-expire after 2-3 minutes
  acceptedAt         DateTime? // When it was accepted
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  client             User                     @relation("ClientInstantChatRequests", fields: [clientId], references: [id], onDelete: Cascade)
  acceptedAstrologer Astrologer?              @relation("AcceptedInstantChatRequests", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([acceptedBy])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

// Broadcast Chat - Clients send messages to "Everyone Jyotish", astrologers see and can accept
model BroadcastMessage {
  id                     String                       @id @default(uuid())
  clientId               String
  content                String
  type                   MessageType                  @default(TEXT)
  status                 BroadcastMessageStatus       @default(PENDING)
  acceptedBy             String? // Astrologer ID who accepted this message
  chatId                 String? // Chat created after acceptance
  acceptedAt             DateTime? // When astrologer accepted
  metadata               Json?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  client                 User                         @relation("ClientBroadcastMessages", fields: [clientId], references: [id], onDelete: Cascade)
  acceptedAstrologer     Astrologer?                  @relation("AcceptedBroadcastMessages", fields: [acceptedBy], references: [id], onDelete: SetNull)
  dismissedByAstrologers BroadcastMessageDismissal[]

  @@index([clientId])
  @@index([status])
  @@index([acceptedBy])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Track which astrologers have dismissed/rejected broadcast messages
model BroadcastMessageDismissal {
  id                 String           @id @default(uuid())
  broadcastMessageId String
  astrologerId       String
  dismissedAt        DateTime         @default(now())
  broadcastMessage   BroadcastMessage @relation(fields: [broadcastMessageId], references: [id], onDelete: Cascade)
  astrologer         Astrologer       @relation("DismissedBroadcastMessages", fields: [astrologerId], references: [id], onDelete: Cascade)

  @@unique([broadcastMessageId, astrologerId]) // Each astrologer can dismiss a message only once
  @@index([broadcastMessageId])
  @@index([astrologerId])
  @@index([dismissedAt])
}

// User complaints about astrologers
model Complaint {
  id             String          @id @default(uuid())
  clientId       String
  astrologerId   String
  chatId         String?
  subject        String
  description    String
  category       ComplaintCategory
  status         ComplaintStatus @default(PENDING)
  priority       ComplaintPriority @default(MEDIUM)
  attachmentUrl  String? // URL to uploaded screenshot/evidence image
  resolvedBy     String? // Admin ID who resolved the complaint
  resolvedAt     DateTime?
  resolution     String? // Admin's resolution notes
  adminNotes     String? // Internal admin notes
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  client         User            @relation("ClientComplaints", fields: [clientId], references: [id], onDelete: Cascade)
  astrologer     Astrologer      @relation("AstrologerComplaints", fields: [astrologerId], references: [id], onDelete: Cascade)
  chat           Chat?           @relation(fields: [chatId], references: [id], onDelete: SetNull)
  resolver       Admin?          @relation("ResolvedComplaints", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([astrologerId])
  @@index([chatId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Future consultation booking system (not implemented yet)
model ConsultationRequest {
  id                 String                    @id @default(uuid())
  clientId           String
  type               ConsultationType
  description        String?
  preferredTime      DateTime?
  duration           Int                       @default(30) // Duration in minutes
  status             ConsultationRequestStatus @default(PENDING)
  acceptedBy         String? // Astrologer ID who accepted
  consultationId     String? // Link to created consultation
  expiresAt          DateTime? // Auto-expire after certain time
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  client             User                      @relation("ClientConsultationRequests", fields: [clientId], references: [id], onDelete: Cascade)
  acceptedAstrologer Astrologer?               @relation("AcceptedConsultationRequests", fields: [acceptedBy], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([status])
  @@index([acceptedBy])
  @@index([createdAt])
  @@index([expiresAt])
}

// Appointment booking system
model Appointment {
  id               String            @id @default(uuid())
  clientId         String
  astrologerId     String
  scheduledAt      DateTime
  duration         Int               @default(30) // Duration in minutes
  status           AppointmentStatus @default(PENDING)
  amount           Float
  notes            String?
  rating           Int?
  review           String?
  cancellationNote String? // Reason for cancellation
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  client           User              @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  astrologer       Astrologer        @relation("AstrologerAppointments", fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([astrologerId])
  @@index([scheduledAt])
  @@index([status])
  @@index([astrologerId, scheduledAt])
}

model Horoscope {
  id         String            @id @default(uuid())
  zodiacSign ZodiacSign
  date       DateTime
  content    String
  category   HoroscopeCategory
  metadata   Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([zodiacSign, date, category])
  @@index([zodiacSign, date])
  @@index([date])
}

model HoroscopeSubscription {
  id           String   @id @default(uuid())
  userId       String   @unique
  isActive     Boolean  @default(true)
  frequency    String   @default("DAILY")
  deliveryTime String   @default("09:00")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Notification {
  id            String           @id @default(uuid())
  userId        String? // Client user ID
  astrologerId  String? // Astrologer ID
  recipientType ParticipantType // CLIENT or ASTROLOGER
  title         String
  message       String
  type          NotificationType
  isRead        Boolean          @default(false)
  metadata      Json?
  groupKey      String? // For grouping notifications (e.g., "chat_from_userId")
  count         Int              @default(1) // Number of notifications in this group
  lastUpdated   DateTime         @default(now()) @updatedAt // Last time this notification was updated
  createdAt     DateTime         @default(now())
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  astrologer    Astrologer?      @relation("AstrologerNotifications", fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([astrologerId])
  @@index([userId, isRead])
  @@index([astrologerId, isRead])
  @@index([createdAt])
  @@index([groupKey])
  @@index([userId, groupKey, isRead])
  @@index([astrologerId, groupKey, isRead])
}

model NotificationSettings {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  notificationsEnabled      Boolean  @default(true)
  chatNotifications         Boolean  @default(true)
  consultationNotifications Boolean  @default(true)
  paymentNotifications      Boolean  @default(true)
  marketingNotifications    Boolean  @default(false)
  emailNotifications        Boolean  @default(true)
  pushNotifications         Boolean  @default(true)
  soundEnabled              Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id             String        @id @default(uuid())
  userId         String
  consultationId String?       @unique
  amount         Float
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  paymentMethod  String
  transactionId  String?       @unique
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([transactionId])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// Dashboard rotating header copy managed by admin
model DashboardRotatingCopy {
  id        String   @id @default(uuid())
  title     String
  subtitle  String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([isActive, sortOrder])
}

// Jyotish service booking requests (Pandit Ji / Vaastu Shastri) created by clients and handled by admin
model JyotishBookingRequest {
  id         String              @id @default(uuid())
  clientId   String
  type       JyotishBookingType
  preferredAstrologerId String?
  category   String
  bookingDate DateTime
  details    String?
  location   String
  status     JyotishBookingStatus @default(PENDING)
  adminNotes String?
  decidedAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  client     User                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  preferredAstrologer Astrologer? @relation("PreferredAstrologerBookings", fields: [preferredAstrologerId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([type])
  @@index([status])
  @@index([bookingDate])
  @@index([preferredAstrologerId])
  @@index([type, status])
  @@index([status, createdAt])
}

model PricingPlan {
  id              String    @id @default(uuid())
  name            String // e.g., "1 Day Unlimited", "50 Chats Pack"
  description     String? // Detailed description
  priceInNrs      Int // Price in Nepali Rupees
  coins           Int // Number of coins (100 Rs = 1 coin = 1 chat)
  coinPrice       Int? // Price in coins for purchasing with coins (e.g., 60 coins for unlimited)
  validityInDays  Int? // Validity period in days (null for permanent)
  isUnlimited     Boolean   @default(false) // Unlimited chats for validity period
  discountPercent Int? // Discount percentage
  isActive        Boolean   @default(true) // Can be enabled/disabled by admin
  isFeatured      Boolean   @default(false) // Show as featured offer
  displayOrder    Int       @default(0) // Order in which to display
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userPlans       UserPlan[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([displayOrder])
}

model UserPlan {
  id              String      @id @default(uuid())
  userId          String
  planId          String
  purchasedWith   String      @default("MONEY") // "MONEY" or "COINS"
  activatedAt     DateTime    @default(now())
  expiresAt       DateTime? // null for permanent plans
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            PricingPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([userId, isActive])
  @@index([expiresAt])
  @@index([planId])
}

enum UserRole {
  CLIENT
  ASTROLOGER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ZodiacSign {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
}

enum ChatStatus {
  ACTIVE
  ENDED
}

enum ConsultationStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InstantChatRequestStatus {
