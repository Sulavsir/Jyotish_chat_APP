{
  "name": "@jyotish/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ./scripts/prisma-generate.cjs && tsc",
    "db:generate": "node ./scripts/prisma-generate.cjs",
    "db:push": "pnpm exec prisma db push",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:migrate:create": "pnpm exec prisma migrate dev --create-only",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "db:migrate:status": "pnpm exec prisma migrate status",
    "db:migrate:reset": "pnpm exec prisma migrate reset",
    "db:studio": "pnpm exec prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:format": "pnpm exec prisma format"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.27",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
