{
  "name": "@jyotish/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js generate && tsc",
    "db:generate": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js generate",
    "db:push": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js db push",
    "db:migrate": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:create": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js migrate dev --create-only",
    "db:migrate:deploy": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:status": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js migrate status",
    "db:migrate:baseline-to-nepal-geography": "dotenv -e ../../.env -- bash ./scripts/baseline-migrations-up-to-nepal-geography.sh",
    "db:migrate:reset": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js migrate reset",
    "db:studio": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js studio",
    "db:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "db:format": "node -r ./scripts/load-prisma-env.cjs ./node_modules/prisma/build/index.js format",
    "db:diagnose": "node ./scripts/diagnose-prisma.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.27",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
