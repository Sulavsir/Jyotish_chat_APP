{
  "name": "@jyotish/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node node_modules/prisma/build/index.js generate && tsc",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:create": "node node_modules/prisma/build/index.js migrate dev --create-only",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:status": "node node_modules/prisma/build/index.js migrate status",
    "db:migrate:reset": "node node_modules/prisma/build/index.js migrate reset",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:format": "node node_modules/prisma/build/index.js format"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.27",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
