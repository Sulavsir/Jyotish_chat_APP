{
  "name": "@jyotish/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ./scripts/prisma-cli.cjs generate && tsc",
    "db:generate": "node ./scripts/prisma-cli.cjs generate",
    "db:push": "node ./scripts/prisma-cli.cjs db push",
    "db:migrate": "node ./scripts/prisma-cli.cjs migrate dev",
    "db:migrate:create": "node ./scripts/prisma-cli.cjs migrate dev --create-only",
    "db:migrate:deploy": "node ./scripts/prisma-cli.cjs migrate deploy",
    "db:migrate:status": "node ./scripts/prisma-cli.cjs migrate status",
    "db:migrate:baseline-to-nepal-geography": "dotenv -e ../../../.env -- bash ./scripts/baseline-migrations-up-to-nepal-geography.sh",
    "db:migrate:reset": "node ./scripts/prisma-cli.cjs migrate reset",
    "db:studio": "node ./scripts/prisma-cli.cjs studio",
    "db:seed": "dotenv -e ../../../.env -- ts-node prisma/seed.ts",
    "db:format": "node ./scripts/prisma-cli.cjs format"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.27",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
